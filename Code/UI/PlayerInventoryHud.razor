@namespace Game
@using System
@using System.Collections.Generic
@using System.Text
@using Sandbox
@using Sandbox.UI
@inherits PanelComponent

<root class="inv-root @(Inventory is not null && Inventory.IsInventoryOpen ? "inv-root-open" : "") @ClosedHotbarDragClass()">
	@if ( Inventory is not null )
	{
		@* Fullscreen no-op layer (kept for layout); ghost/hover run from OnUpdate + Mouse.Delta vs stale Mouse.Position. *@
		<InventoryHudDragPumpPanel @ref="_dragPump" />

		<label class="inv-build-watermark">v@(GameBuildLabel.Display)</label>

		@if ( Inventory.IsInventoryOpen )
		{
			<div id="inv-backdrop"
			     class="inv-backdrop"
			     @onmouseup="OnBackdropMouseUp"></div>
			<div class="inv-window"
			     @onmousedown="OnInventoryChromeMouseDown"
			     @onmouseup="OnInvWindowMouseUp">
				<div class="inv-window-left">
					<ScenePanel @ref="_scenePanel" class="inv-scene" />
				</div>
				<div class="inv-window-right">
					<div class="inv-grid-title">Inventory</div>
					<div class="inv-grid">
						@for ( var j = 0; j < Inventory.BackpackSlotCount; j++ )
						{
							var idx = Inventory.HotbarSlotCount + j;
							var slot = Inventory.GetSlot( idx );
							<div id="inv-slot-win-@idx"
							     class="@InvBackpackSlotClass( idx )"
							     data-slot="@idx"
							     @onmousedown="@(e => OnSlotMouseDown( idx, "win", e ))"
							     @onmouseup="@(e => OnSlotMouseUp( idx, "win", e ))"
							     @onmouseenter="@(e => OnSlotMouseEnter( idx, e ))"
							     @onmouseleave="@(e => OnSlotMouseLeave( idx, e ))">
								@if ( !slot.IsEmpty && Inventory.TryGetDefinition( slot.ItemId, out var def ) )
								{
									<InvSlotIconFill TexturePath="@def.IconTexturePath" />
									@if ( def.Stackable && slot.Count >= 1 )
									{
										<div class="inv-slot-count">@slot.Count</div>
									}
								}
							</div>
						}
					</div>
					<div id="inv-drop-world"
					     class="inv-drop-zone"
					     @onmouseup="OnDropZoneMouseUp"
					     @onclick="OnDropZoneClick">
						Drop item
					</div>
				</div>
			</div>
		}

		@if ( _dragUiCapture && TryGetDragPreview( out var dragDefGhost, out var dragCountGhost ) )
		{
			<div class="inv-drag-ghost">
				<div class="inv-drag-ghost-fillwrap">
					<InvSlotIconFill TexturePath="@dragDefGhost.IconTexturePath" ExtraClass="inv-icon-raw inv-drag-ghost-fill" />
				</div>
				@if ( dragDefGhost.Stackable && dragCountGhost > 1 )
				{
					<div class="inv-drag-count">@dragCountGhost</div>
				}
			</div>
		}

		@if ( _dragUiCapture && Inventory.DebugInventory )
		{
			<div class="inv-drag-debug">@_dragDebugText</div>
		}

		<div class="inv-hotbar-wrap">
			<div class="inv-hotbar">
				@for ( var i = 0; i < Inventory.HotbarSlotCount; i++ )
				{
					var idx = i;
					var slot = Inventory.GetSlot( idx );
					<div id="inv-slot-dock-@idx"
					     class="@InvHotbarSlotClass( idx )"
					     data-slot="@idx"
					     @onmousedown="@(e => OnSlotMouseDown( idx, "dock", e ))"
					     @onmouseup="@(e => OnSlotMouseUp( idx, "dock", e ))"
					     @onmouseenter="@(e => OnSlotMouseEnter( idx, e ))"
					     @onmouseleave="@(e => OnSlotMouseLeave( idx, e ))">
						@if ( !slot.IsEmpty && Inventory.TryGetDefinition( slot.ItemId, out var def ) )
						{
							<InvSlotIconFill TexturePath="@def.IconTexturePath" />
							@if ( def.Stackable && slot.Count >= 1 )
							{
								<div class="inv-slot-count">@slot.Count</div>
							}
						}
					</div>
				}
			</div>
		</div>
	}
</root>

@code
{
	[Property] public PlayerInventory Inventory { get; set; }

	private ScenePanel _scenePanel;
	private InventoryHudDragPumpPanel _dragPump;
	private int _dragFrom = -1;
	private bool _dragSplit;
	private bool _scenePreviewBuilt;
	private float _dragMouseX;
	private float _dragMouseY;
	/// <summary>Screen-space point for ghost + hover.</summary>
	private Vector2 _dragGhostScreenPx;

	private float _dragDbgNextLogAt;
	private int _dragDbgGhostCalls;
	private Panel _dragGhostPanel;
	private int _hoverSlot = -1;
	private int _dragLastHoverSlot = -1;
	private Dictionary<int, Panel> _slotPanelsByIndex;
	private List<Panel> _slotPanels;
	private struct SlotGeom
	{
		public int idx;
		public Rect screenBounds;
		public Vector2 center;
	}

	private List<SlotGeom> _slotGeoms;
	private int _decorAppliedSource = -1;
	private int _decorAppliedHover = -1;
	private string _dragSourceKind = "";
	private string _dragDebugText = "";

	/// <summary>True from slot left-mousedown until a completing UI mouseup (slot, backdrop, drop zone, or window chrome).</summary>
	private bool _dragUiCapture;

	protected override void OnMouseMove( MousePanelEvent e )
	{
		base.OnMouseMove( e );
	}

	protected override void OnEnabled()
	{
		if ( Inventory is not null )
			Inventory.OnInventoryChanged += OnInvChanged;

		base.OnEnabled();
	}

	protected override void OnDisabled()
	{
		if ( Inventory is not null )
			Inventory.OnInventoryChanged -= OnInvChanged;

		Mouse.Visibility = MouseVisibility.Auto;

		if ( _dragPump is not null )
			_dragPump.Host = null;

		StopDragPresentationAndClearDecorations();

		base.OnDisabled();
	}

	private string ClosedHotbarDragClass()
	{
		if ( Inventory is null || Inventory.IsInventoryOpen || !_dragUiCapture )
			return "";

		return "inv-closed-drag";
	}

	/// <summary>
	/// For gameplay we keep the root pass-through (<c>pointer-events:none</c>) so empty HUD space does not steal look.
	/// During drag we must allow the root to receive cursor tracking; otherwise <see cref="Panel.MousePosition"/> and layout are wrong
	/// (telemetry: <c>panelMouse</c> ≠ <see cref="Mouse.Position"/>).
	/// </summary>
	private void ApplyRootPointerPassthroughUnlessDragging()
	{
		if ( Panel is null )
			return;

		Panel.Style.PointerEvents =
			_dragUiCapture && _dragFrom >= 0 ? Sandbox.UI.PointerEvents.All : Sandbox.UI.PointerEvents.None;
	}

	/// <summary>
	/// Screen HUD often leaves the cursor unlocked for UI even with pointer-events:none; <see cref="PlayerController"/>
	/// then never receives look. <see cref="Mouse.Active"/> is read-only in current s&box builds — toggle <see cref="Mouse.Visibility"/> only.
	/// </summary>
	private void SyncGameplayMouseForPlayerController()
	{
		if ( Inventory is null )
			return;

		var uiPointerMode = Inventory.IsInventoryOpen || _dragUiCapture;
		Mouse.Visibility = uiPointerMode ? MouseVisibility.Visible : MouseVisibility.Hidden;
	}

	private void HudDbg( string message )
	{
		if ( Inventory is null || !Inventory.DebugInventory )
			return;

		Log.Info( $"[PlayerInventoryHud] {message}" );
	}

	/// <summary>1 Hz while dragging (requires <see cref="PlayerInventory.DebugInventory"/>) so the console shows live pump stats, not only on mouseup.</summary>
	private void TryHudDragTelemetrySecondTick()
	{
		if ( Inventory is null || !Inventory.DebugInventory || !_dragUiCapture || _dragFrom < 0 )
			return;

		if ( Time.Now < _dragDbgNextLogAt )
			return;

		_dragDbgNextLogAt = Time.Now + 1f;
		var auth = Mouse.Position;
		var pm = Panel is not null && Panel.IsValid ? Panel.MousePosition : default;
		var scl = Panel is not null && Panel.IsValid ? Panel.ScaleToScreen : 0f;
		var pe = Panel?.Style?.PointerEvents.ToString() ?? "?";
		Log.Info(
			$"[PlayerInventoryHud] drag.telemetry (1s): calls={_dragDbgGhostCalls} ptr={pe} | " +
			$"auth=({auth.x:0.##},{auth.y:0.##}) ghost=({_dragGhostScreenPx.x:0.##},{_dragGhostScreenPx.y:0.##}) err={(_dragGhostScreenPx - auth).Length:0.##} | " +
			$"mouseΔ=({Mouse.Delta.x:0.##},{Mouse.Delta.y:0.##}) inΔ=({Input.MouseDelta.x:0.##},{Input.MouseDelta.y:0.##}) | " +
			$"rootLocal=({_dragMouseX:0.##},{_dragMouseY:0.##}) panelMouse=({pm.x:0.##},{pm.y:0.##}) scale={scl:0.####} Δ={Time.Delta:0.##}" );

		_dragDbgGhostCalls = 0;
	}

	private void ResetHudDragTelemetrySchedule()
	{
		_dragDbgNextLogAt = Time.Now + 0.2f;
		_dragDbgGhostCalls = 0;
	}

	private void HudPointerDbg( string source, MousePanelEvent me, string extra = "" )
	{
		if ( Inventory is null || !Inventory.DebugInventory )
			return;

		var btn = me is null ? "" : $" button={me.Button}";
		Log.Info( $"[PlayerInventoryHud] {source}{btn} {extra}".TrimEnd() );
	}

	private void OnSlotMouseEnter( int slotIndex, PanelEvent _ )
	{
		_hoverSlot = slotIndex;
		if ( _dragUiCapture && _dragFrom >= 0 )
			_dragLastHoverSlot = slotIndex;
	}

	private void OnSlotMouseLeave( int slotIndex, PanelEvent _ )
	{
		if ( _hoverSlot == slotIndex )
			_hoverSlot = -1;

		if ( _dragUiCapture && _dragFrom >= 0 && _dragLastHoverSlot == slotIndex )
		{
			_dragLastHoverSlot = -1;
		}
	}

	public int TryGetRealtimeHoveredSlotIndex()
		=> _hoverSlot;

	private Panel FindSlotPanelByKindAndIndex( string kind, int idx )
	{
		if ( Panel is null || string.IsNullOrWhiteSpace( kind ) || idx < 0 )
			return null;

		var wantId = $"inv-slot-{kind}-{idx}";
		foreach ( var p in Panel.Descendants )
		{
			if ( p is null || !TryParseInventorySlotHitPanel( p, out _ ) )
				continue;

			if ( string.Equals( p.Id, wantId, StringComparison.Ordinal ) )
				return p;
		}

		return null;
	}

	private static Vector2 GetSlotLocalSize( Panel p )
	{
		if ( p is null )
			return default;

		var outer = p.Box.Rect;
		var inner = p.Box.RectInner;
		var w = MathF.Max( Math.Abs( outer.Width ), Math.Abs( inner.Width ) );
		var h = MathF.Max( Math.Abs( outer.Height ), Math.Abs( inner.Height ) );
		return new Vector2( w, h );
	}

	private int ResolveSlotByUiDocumentPoint( Vector2 gameMousePx )
	{
		if ( Panel is null || Inventory is null )
			return -1;

		var uiPt = MouseGamePixelsToUiDocumentPickSpace( gameMousePx );
		var bestInside = -1;
		var bestInsideCenterD2 = float.MaxValue;
		var bestNear = -1;
		var bestNearEdgeD2 = float.MaxValue;
		var bestNearCenterD2 = float.MaxValue;

		var panels = _slotPanels ?? Panel.Descendants;
		foreach ( var p in panels )
		{
			if ( p is null || !TryParseInventorySlotHitPanel( p, out var idx ) )
				continue;

			if ( idx < 0 || idx >= Inventory.TotalSlotCount )
				continue;

			if ( !TryGetInvSlotHitRectInScreenSpace( p, out var sb ) )
				continue;

			var minX = MathF.Min( sb.Left, sb.Right );
			var maxX = MathF.Max( sb.Left, sb.Right );
			var minY = MathF.Min( sb.Top, sb.Bottom );
			var maxY = MathF.Max( sb.Top, sb.Bottom );
			var cx = (minX + maxX) * 0.5f;
			var cy = (minY + maxY) * 0.5f;
			var dx = uiPt.x - cx;
			var dy = uiPt.y - cy;
			var centerD2 = dx * dx + dy * dy;
			var edgeD2 = SquaredDistancePointToAxisAlignedRect( uiPt, sb );

			if ( edgeD2 <= 0.0001f )
			{
				if ( centerD2 < bestInsideCenterD2 )
				{
					bestInsideCenterD2 = centerD2;
					bestInside = idx;
				}
				continue;
			}

			if ( edgeD2 < bestNearEdgeD2 || (MathF.Abs( edgeD2 - bestNearEdgeD2 ) < 0.001f && centerD2 < bestNearCenterD2) )
			{
				bestNearEdgeD2 = edgeD2;
				bestNearCenterD2 = centerD2;
				bestNear = idx;
			}
		}

		if ( bestInside >= 0 )
			return bestInside;

		const float maxNearPx = 140f;
		return bestNearEdgeD2 <= maxNearPx * maxNearPx ? bestNear : -1;
	}

	private int ResolveHoveredSlotRealtime( Vector2 screenPt )
		=> ResolveSlotByUiDocumentPoint( screenPt );

	private int ResolveHoveredSlotScreenSpaceCached( Vector2 screenPt )
	{
		if ( _slotGeoms is null || _slotGeoms.Count == 0 )
			return ResolveHoveredSlotRealtime( screenPt );

		var bestInside = -1;
		var bestInsideCenterD2 = float.MaxValue;
		var bestNear = -1;
		var bestNearEdgeD2 = float.MaxValue;
		var bestNearCenterD2 = float.MaxValue;

		foreach ( var g in _slotGeoms )
		{
			var sb = g.screenBounds;
			if ( sb.Width <= 0.1f || sb.Height <= 0.1f )
				continue;

			var dx = screenPt.x - g.center.x;
			var dy = screenPt.y - g.center.y;
			var centerD2 = dx * dx + dy * dy;

			var edgeD2 = SquaredDistancePointToAxisAlignedRect( screenPt, sb );

			if ( edgeD2 <= 0.0001f )
			{
				if ( centerD2 < bestInsideCenterD2 )
				{
					bestInsideCenterD2 = centerD2;
					bestInside = g.idx;
				}
				continue;
			}

			if ( edgeD2 < bestNearEdgeD2 || (MathF.Abs( edgeD2 - bestNearEdgeD2 ) < 0.001f && centerD2 < bestNearCenterD2) )
			{
				bestNearEdgeD2 = edgeD2;
				bestNearCenterD2 = centerD2;
				bestNear = g.idx;
			}
		}

		if ( bestInside >= 0 )
			return bestInside;

		const float maxNearPx = 140f;
		return bestNearEdgeD2 <= maxNearPx * maxNearPx ? bestNear : -1;
	}

	private int TryPickSlotFromBoundSlotLocal( int boundSlot, Vector2 sourceLocalPointer )
	{
		if ( Panel is null || Inventory is null || boundSlot < 0 )
			return -1;

		var source = FindSlotPanelByKindAndIndex( _dragSourceKind, boundSlot );
		if ( source is null )
			return ResolveSlotByUiDocumentPoint( Mouse.Position );

		var bestIdx = -1;
		var bestD2 = float.MaxValue;
		foreach ( var p in Panel.Descendants )
		{
			if ( p is null || !TryParseInventorySlotHitPanel( p, out var idx ) )
				continue;

			if ( idx < 0 || idx >= Inventory.TotalSlotCount )
				continue;

			var sz = GetSlotLocalSize( p );
			if ( sz.x <= 0.75f || sz.y <= 0.75f )
				continue;

			var center = new Vector2( sz.x * 0.5f, sz.y * 0.5f );
			var centerScreen = p.PanelPositionToScreenPosition( center );
			var centerInSource = source.ScreenPositionToPanelPosition( centerScreen );
			var dx = sourceLocalPointer.x - centerInSource.x;
			var dy = sourceLocalPointer.y - centerInSource.y;
			var d2 = dx * dx + dy * dy;
			if ( d2 < bestD2 )
			{
				bestD2 = d2;
				bestIdx = idx;
			}
		}

		return bestIdx;
	}

	private void OnInvChanged()
	{
		if ( Inventory is not null && !Inventory.IsInventoryOpen )
			_scenePreviewBuilt = false;

		StateHasChanged();
	}

	private void BeginSlotDragFromFilledSlot( int slotIndex, string sourceKind, MousePanelEvent sourceEvent = null )
	{
		_dragSplit = Input.Down( "walk" );
		_dragFrom = slotIndex;
		_dragSourceKind = sourceKind ?? "";
		_dragLastHoverSlot = slotIndex;
		_dragUiCapture = true;
		InvalidateDragGhostPanelReference();
		ApplyRootPointerPassthroughUnlessDragging();
		var m = Mouse.Position;
		_dragGhostScreenPx = m;
		if ( Inventory.DebugInventory )
			ResetHudDragTelemetrySchedule();
		UpdateDragGhostFromRootMouse();
		_hoverSlot = ResolveHoveredSlotScreenSpaceCached( _dragGhostScreenPx );
		if ( _hoverSlot >= 0 )
			_dragLastHoverSlot = _hoverSlot;
		ApplyDragDecorations( sourceIdx: _dragFrom, hoverIdx: _hoverSlot );
	}

	/// <summary>
	/// Ghost tracks <see cref="Mouse.Position"/> only (no <see cref="Mouse.Delta"/> — wrong scale in telemetry).
	/// Layout uses the <b>same</b> math as <see cref="UpdateDragMouse"/> (origin + <see cref="Panel.ScaleToScreen"/>), not <see cref="Panel.ScreenPositionToPanelPosition"/>,
	/// which offset the icon from the cursor in ScreenPanel builds.
	/// </summary>
	private void UpdateDragGhostFromRootMouse()
	{
		if ( !_dragUiCapture || _dragFrom < 0 || Panel is null || !Panel.IsValid )
			return;

		_dragGhostScreenPx = Mouse.Position;
		UpdateDragMouse();
		ApplyDragGhostPanelPosition();
	}

	/// <summary>UI <see cref="Sandbox.UI.Panel.Tick"/> — same math as <see cref="OnUpdate"/>, safe to call every frame (no delta integration).</summary>
	public void PumpDragPresentationUiTick()
	{
		if ( Inventory is null || !_dragUiCapture || _dragFrom < 0 || Panel is null || !Panel.IsValid )
			return;

		UpdateDragGhostFromRootMouse();
		UpdateDragHoverFromScreenPointAndApply();
	}

	private void UpdateDragHoverFromScreenPointAndApply()
	{
		if ( !_dragUiCapture || _dragFrom < 0 || Inventory is null || Panel is null || !Panel.IsValid )
			return;

		var hover = ResolveHoveredSlotScreenSpaceCached( _dragGhostScreenPx );
		if ( hover == _hoverSlot )
			return;

		_hoverSlot = hover;
		if ( hover >= 0 )
			_dragLastHoverSlot = hover;

		ApplyDragDecorations( sourceIdx: _dragFrom, hoverIdx: hover );
	}

	private void InvalidateDragGhostPanelReference()
		=> _dragGhostPanel = null;

	private void StopDragPresentationAndClearDecorations()
	{
		ClearDragSlotDecorationClasses();
		InvalidateDragGhostPanelReference();
	}

	private void ApplyDragDecorations( int sourceIdx, int hoverIdx )
	{
		if ( !_dragUiCapture )
			return;

		// Clear previous decorations without scanning the whole tree.
		if ( _decorAppliedSource >= 0 && _decorAppliedSource != sourceIdx )
			SetSlotClass( _decorAppliedSource, "inv-slot-drag-source", false );
		if ( _decorAppliedHover >= 0 && _decorAppliedHover != hoverIdx )
			SetSlotClass( _decorAppliedHover, "inv-slot-drag-hover", false );

		_decorAppliedSource = sourceIdx;
		_decorAppliedHover = hoverIdx;

		if ( sourceIdx >= 0 )
			SetSlotClass( sourceIdx, "inv-slot-drag-source", true );

		var showHover = hoverIdx >= 0 && hoverIdx != sourceIdx;
		if ( hoverIdx >= 0 )
			SetSlotClass( hoverIdx, "inv-slot-drag-hover", showHover );
	}

	private void ClearDragSlotDecorationClasses()
	{
		if ( _decorAppliedSource >= 0 )
			SetSlotClass( _decorAppliedSource, "inv-slot-drag-source", false );
		if ( _decorAppliedHover >= 0 )
			SetSlotClass( _decorAppliedHover, "inv-slot-drag-hover", false );

		_decorAppliedSource = -1;
		_decorAppliedHover = -1;
	}

	private void SetSlotClass( int idx, string className, bool enabled )
	{
		if ( Panel is null || idx < 0 )
			return;

		var p = FindSlotPanelCached( idx );
		if ( p is null )
			return;

		p.SetClass( className, enabled );
	}

	private Panel FindSlotPanelCached( int idx )
	{
		if ( _slotPanelsByIndex is null || !_slotPanelsByIndex.TryGetValue( idx, out var p ) || p is null || !p.IsValid )
		{
			// Lazy rebuild if needed (e.g. hotload / re-tree build).
			RebuildSlotPanelCache();
			if ( _slotPanelsByIndex is null || !_slotPanelsByIndex.TryGetValue( idx, out p ) )
				return null;
		}

		return p;
	}

	private void RebuildSlotPanelCache()
	{
		if ( Panel is null )
			return;

		_slotPanelsByIndex = new Dictionary<int, Panel>();
		_slotPanels = new List<Panel>();
		_slotGeoms = new List<SlotGeom>();

		foreach ( var p in Panel.Descendants )
		{
			if ( p is null || !p.IsValid )
				continue;

			if ( !TryParseInventorySlotHitPanel( p, out var idx ) )
				continue;

			if ( idx < 0 )
				continue;

			// Prefer the first encountered panel for each slot index.
			if ( !_slotPanelsByIndex.ContainsKey( idx ) )
			{
				_slotPanelsByIndex[idx] = p;
				if ( TryGetInvSlotHitRectInScreenSpace( p, out var sb ) )
				{
					var minX = MathF.Min( sb.Left, sb.Right );
					var maxX = MathF.Max( sb.Left, sb.Right );
					var minY = MathF.Min( sb.Top, sb.Bottom );
					var maxY = MathF.Max( sb.Top, sb.Bottom );
					var center = new Vector2( (minX + maxX) * 0.5f, (minY + maxY) * 0.5f );

					_slotGeoms.Add( new SlotGeom
					{
						idx = idx,
						screenBounds = sb,
						center = center
					} );
				}
			}

			_slotPanels.Add( p );
		}
	}

	private void OnSlotMouseDown( int slotIndex, string sourceKind, PanelEvent e )
	{
		if ( Inventory is null || e is not MousePanelEvent me )
			return;

		if ( me.Button == "mouseright" )
		{
			HudPointerDbg( $"slot MOUSEDOWN bind={slotIndex} → split", me );
			TrySplitToFirstEmpty( slotIndex );
			me.StopPropagation();
			return;
		}

		if ( me.Button != "mouseleft" )
			return;

		var s = Inventory.GetSlot( slotIndex );
		if ( s.IsEmpty )
		{
			HudPointerDbg( $"slot MOUSEDOWN bind={slotIndex} ignored (empty)", me );
			return;
		}

		BeginSlotDragFromFilledSlot( slotIndex, sourceKind, me );
		me.StopPropagation();
		HudPointerDbg( $"slot MOUSEDOWN bind={slotIndex} → drag start split={_dragSplit}", me );
		StateHasChanged();
	}

	private void OnSlotMouseUp( int slotIndex, string sourceKind, PanelEvent e )
	{
		if ( e is not MousePanelEvent me || me.Button != "mouseleft" )
			return;

		if ( Inventory is null )
			return;

		if ( _dragFrom < 0 || !_dragUiCapture )
		{
			HudPointerDbg( $"slot MOUSEUP bind={slotIndex} (no active drag)", me );
			_dragUiCapture = false;
			StopDragPresentationAndClearDecorations();
			return;
		}

		// s&box does not reliably deliver bubbled mouseup to <root>; always finish here using Mouse.Position + hit-test (not bind).
		HudPointerDbg( $"slot MOUSEUP bind={slotIndex} → FinishPointerDrag", me );
		FinishPointerDrag( HudReason: $"slot-mouseup(bind={slotIndex},src={sourceKind})", boundSlot: slotIndex, sourceLocalPtr: me.LocalPosition );
		me.StopPropagation();
		StateHasChanged();
	}

	private void TrySplitToFirstEmpty( int fromIndex )
	{
		if ( Inventory is null )
			return;

		var s = Inventory.GetSlot( fromIndex );
		if ( s.IsEmpty || s.Count <= 1 )
			return;

		if ( TrySplitFindEmpty( fromIndex, 0, Inventory.HotbarSlotCount ) )
			return;

		TrySplitFindEmpty( fromIndex, Inventory.HotbarSlotCount, Inventory.TotalSlotCount );
	}

	private bool TrySplitFindEmpty( int fromIndex, int start, int endEx )
	{
		for ( var i = start; i < endEx; i++ )
		{
			if ( i == fromIndex )
				continue;

			if ( !Inventory.GetSlot( i ).IsEmpty )
				continue;

			Inventory.RequestMoveSlot( fromIndex, i, splitHalf: true );
			return true;
		}

		return false;
	}

	public void RequestDropFromDrag()
	{
		if ( Inventory is null || _dragFrom < 0 )
			return;

		HudDbg( $"RequestDropFromDrag slot={_dragFrom}" );
		var dropIdx = _dragFrom;
		Inventory.RequestDropSlotToWorld( dropIdx, dropAll: true );

		_dragUiCapture = false;
		_dragFrom = -1;
		_dragSplit = false;
		_dragSourceKind = "";
		StopDragPresentationAndClearDecorations();

		StateHasChanged();
	}

	private void OnDropZoneMouseUp( PanelEvent e )
	{
		if ( e is not MousePanelEvent me || me.Button != "mouseleft" )
			return;

		if ( _dragFrom < 0 || !_dragUiCapture )
			return;

		HudPointerDbg( "drop-zone MOUSEUP → RequestDropFromDrag", me );
		RequestDropFromDrag();
		me.StopPropagation();
		StateHasChanged();
	}

	private void OnDropZoneClick( PanelEvent e )
	{
		if ( _dragFrom < 0 || !_dragUiCapture )
			return;

		if ( e is MousePanelEvent me )
		{
			HudPointerDbg( "drop-zone CLICK → RequestDropFromDrag", me );
			RequestDropFromDrag();
			me.StopPropagation();
		}
		else
		{
			RequestDropFromDrag();
		}

		StateHasChanged();
	}

	private void OnInvWindowMouseUp( PanelEvent e )
	{
		if ( e is not MousePanelEvent me || me.Button != "mouseleft" )
			return;

		if ( Inventory is null || _dragFrom < 0 || !_dragUiCapture )
			return;

		HudPointerDbg( "inv-window MOUSEUP → FinishPointerDrag (chrome/padding)", me );
		FinishPointerDrag( HudReason: "inv-window-mouseup" );
		me.StopPropagation();
		StateHasChanged();
	}

	private void OnBackdropMouseUp( PanelEvent e )
	{
		if ( e is not MousePanelEvent me || me.Button != "mouseleft" )
			return;

		if ( _dragFrom < 0 || !_dragUiCapture )
			return;

		HudPointerDbg( "backdrop MOUSEUP → RequestDropFromDrag", me );
		RequestDropFromDrag();
		me.StopPropagation();
		StateHasChanged();
	}

	private void OnInventoryChromeMouseDown( PanelEvent e )
	{
		if ( Inventory is null || !Inventory.IsInventoryOpen || e is not MousePanelEvent me )
			return;

		if ( me.Button != "mouseleft" && me.Button != "mouseright" )
			return;

		HudPointerDbg( "inv-window-chrome MOUSEDOWN", me );
	}

	private void FinishPointerDrag( string HudReason, int boundSlot = -1, Vector2? sourceLocalPtr = null )
	{
		if ( Inventory is null || _dragFrom < 0 || !_dragUiCapture )
			return;

		UpdateDragMouse();
		// Hit tests must use the same space as Sandbox UI panel geometry (raw screen mouse). Ghost math should match too,
		// but reconstructed ptr was causing false outsides alongside tight Grow() — Mouse.Position stays authoritative at release.
		var ptr = Mouse.Position;

		// Mouseup is delivered to the slot that started the drag (implicit capture), not the slot under the cursor.
		// Primary: deterministic screen-rect containment against rendered slot rectangles.
		var stepBoundLocal = sourceLocalPtr.HasValue ? TryPickSlotFromBoundSlotLocal( boundSlot, sourceLocalPtr.Value ) : -1;
		var stepHover = _dragLastHoverSlot >= 0 ? _dragLastHoverSlot : _hoverSlot >= 0 ? _hoverSlot : -1;
		// Use the last live hover as authoritative drop target; this must match the blue prediction.
		var stepInside = stepHover >= 0 ? stepHover : stepBoundLocal >= 0 ? stepBoundLocal : TryGetSlotIndexUnderScreenPoint( ptr );
		var stepClosest = stepInside < 0 ? PickInventorySlotByClosestLocalRect( ptr ) : -1;
		var stepFind = stepInside < 0 && stepClosest < 0 ? TryPickInventorySlotViaFindInRect( ptr ) : -1;
		var stepScreen = stepInside < 0 && stepFind < 0 && stepClosest < 0 ? TryPickInventorySlotUsingScreenCoordsOnly( ptr ) : -1;
		var stepChain = -1;
		var stepNear =
			stepInside < 0 && stepClosest < 0
				? TryPickInvSlotNearestUsingPanelMouse( ptr, maxPx: 2000f )
				: -1;

		var toSlot = stepInside >= 0 ? stepInside : stepClosest >= 0 ? stepClosest : stepFind >= 0 ? stepFind : stepScreen >= 0 ? stepScreen : stepChain >= 0 ? stepChain : stepNear;

		HudDbg(
			$"drag end ({HudReason}) dragPtr=({ptr.x:0},{ptr.y:0}) pickSlot={toSlot} from={_dragFrom} steps(src={stepBoundLocal} in={stepInside} close={stepClosest} find={stepFind} scr={stepScreen} chain={stepChain} near={stepNear})" );

		var fromSlot = _dragFrom;
		var requestedMove = false;
		if ( toSlot >= 0 && toSlot < Inventory.TotalSlotCount && toSlot != fromSlot )
		{
			Inventory.RequestMoveSlot( fromSlot, toSlot, _dragSplit );
			requestedMove = true;
		}

		var shownHover = stepHover >= 0 ? stepHover + 1 : -1;
		var shownPick = toSlot >= 0 ? toSlot + 1 : -1;
		_dragDebugText =
			$"from={fromSlot + 1} hover={shownHover} pick={shownPick} src={stepBoundLocal} reqMove={(requestedMove ? 1 : 0)} kind={_dragSourceKind}";

		_dragFrom = -1;
		_dragSplit = false;
		_dragUiCapture = false;
		_hoverSlot = -1;
		_dragLastHoverSlot = -1;
		_dragSourceKind = "";

		StopDragPresentationAndClearDecorations();
	}

	/// <summary>Heavy hit-test logging when <see cref="PlayerInventory.DebugInventory"/> is on (drag release).</summary>
	private void LogDragPickDeepDiagnostics( Vector2 ptr, int finalPick, int stepInside, int stepClose, int stepFind,
		int stepScreen, int stepChain, int stepNear )
	{
		if ( Inventory is null || !Inventory.DebugInventory || Panel is null )
			return;

		HudDbg(
			$"dragPickDiag root elem={Panel.ElementName} id={Panel.Id} ch={Panel.ChildrenCount} final={finalPick} steps(in={stepInside} cl={stepClose} fr={stepFind} sc={stepScreen} chn={stepChain} nr={stepNear}) mouse=({Mouse.Position.x:0},{Mouse.Position.y:0})" );

		var invSlots = new List<Panel>();
		foreach ( var p in Panel.Descendants )
		{
			if ( p is not null && p.HasClass( "inv-slot" ) )
				invSlots.Add( p );
		}

		HudDbg( $"dragPickDiag panels HasClass(inv-slot)={invSlots.Count}" );

		var uiPick = MouseGamePixelsToUiDocumentPickSpace( ptr );

		foreach ( var pad in new[] { 2f, 10f, 40f } )
		{
			HudDbg( $"dragPickDiag probe±{pad:0.#} px gameCenter=({ptr.x:0},{ptr.y:0}) uiCenter=({uiPick.x:0},{uiPick.y:0})" );

			var probeGame = Rect.FromPoints( ptr + new Vector2( -pad, -pad ), ptr + new Vector2( pad, pad ) );
			var probeUi = Rect.FromPoints( uiPick + new Vector2( -pad, -pad ), uiPick + new Vector2( pad, pad ) );

			HudDbg(
				$"dragPickDiag   leavesGameRaw={CountFindInRectLeaves( probeGame )} leavesUiCalib={CountFindInRectLeaves( probeUi )}" );

			var probe = probeUi;
			var rVis = TryResolveSlotIndexFromFindInRectProbe( probe, visibleLeavesOnly: true );
			var rAny = TryResolveSlotIndexFromFindInRectProbe( probe, visibleLeavesOnly: false );

			var leafTotal = 0;
			var leafVis = 0;
			var sample = new StringBuilder();
			var sampleLeft = 10;
			foreach ( var leaf in Panel.FindInRect( probe, fullyInside: false ) )
			{
				if ( leaf is null )
					continue;

				leafTotal++;
				if ( leaf.IsVisible )
					leafVis++;

				if ( sampleLeft-- > 0 && sample.Length < 440 )
				{
					if ( sample.Length > 0 )
						sample.Append( " | " );

					sample.Append( DragPickPanelOneLiner( leaf ) );
				}
			}

			HudDbg(
				$"dragPickDiag probe±{pad:0.#} px leaves={leafTotal} leavesVis={leafVis} resolvedVis={rVis} resolvedAny={rAny}" );
			HudDbg( $"dragPickDiag   leafSample {sample}" );
		}

		foreach ( var p in invSlots )
		{
			if ( !TryParseInventorySlotHitPanel( p, out var idx ) )
			{
				HudDbg(
					$"dragPickDiag ORPHAN inv-slot elem={p.ElementName} id={p.Id} classesRaw=[{CssClassTokens( p )}]" );
				continue;
			}

			GetInvSlotPickRect( p, 52f, out var rg );
			var lp = p.ScreenPositionToPanelPosition( ptr );
			var inside = InvAxisRectContainsPoint( lp, rg );
			var inner = p.Box.RectInner;
			var tl = p.PanelPositionToScreenPosition( new Vector2( rg.Left, rg.Top ) );
			var br = p.PanelPositionToScreenPosition( new Vector2( rg.Right, rg.Bottom ) );

			HudDbg(
				$"dragPickDiag slot[{idx}] id={p.Id} elem={p.ElementName} vis={p.IsVisible} inner={inner.Width:0}x{inner.Height:0} loc52=({lp.x:0},{lp.y:0}) inGrow52={inside} scrAABB=({tl.x:0},{tl.y:0})-({br.x:0},{br.y:0})" );
		}
	}

	// Razor/codegen sometimes referenced the old name; keep a forwarder.
	private int CountFindInRectLeaves( Rect probe ) => CountFindInRectLeavesThisTree( probe );

	private int CountFindInRectLeavesThisTree( Rect probe )
	{
		if ( Panel is null )
			return 0;

		var n = 0;
		foreach ( var leaf in Panel.FindInRect( probe, fullyInside: false ) )
			n++;

		return n;
	}

	private static string DragPickPanelOneLiner( Panel p )
	{
		var cls = p.Classes ?? "";
		if ( cls.Length > 56 )
			cls = cls.Substring( 0, 56 ) + "…";

		return $"{p.ElementName}#{p.Id} v={( p.IsVisible ? 1 : 0 )}:{cls}";
	}

	/// <summary>
	/// <see cref="Panel.FindInRect"/> works in screen space and ignores which panel received mouseup during drag capture.
	/// </summary>
	private int TryPickInventorySlotViaFindInRect( Vector2 gameMousePx )
	{
		if ( Panel is null )
			return -1;

		var uiPt = MouseGamePixelsToUiDocumentPickSpace( gameMousePx );

		for ( var pass = 0; pass < 2; pass++ )
		{
			var visibleOnly = pass == 0;
			foreach ( var pad in new[] { 2f, 10f, 40f } )
			{
				var probe = Rect.FromPoints(
					uiPt + new Vector2( -pad, -pad ), uiPt + new Vector2( pad, pad ) );
				var hit = TryResolveSlotIndexFromFindInRectProbe( probe, visibleLeavesOnly: visibleOnly );
				if ( hit >= 0 )
					return hit;
			}
		}

		return -1;
	}

	private int TryResolveSlotIndexFromFindInRectProbe( Rect probe, bool visibleLeavesOnly )
	{
		if ( Panel is null )
			return -1;

		var bestIdx = -1;
		var bestLeafDepth = -1;

		foreach ( var leaf in Panel.FindInRect( probe, fullyInside: false ) )
		{
			if ( leaf is null )
				continue;

			if ( visibleLeavesOnly && !leaf.IsVisible )
				continue;

			var leafDepth = CountPanelAncestors( leaf );
			for ( var q = leaf; q is not null; q = q.Parent )
			{
				if ( ReferenceEquals( q, Panel ) )
					break;

				if ( TryParseInventorySlotHitPanel( q, out var idx ) )
				{
					if ( leafDepth > bestLeafDepth )
					{
						bestLeafDepth = leafDepth;
						bestIdx = idx;
					}

					break;
				}
			}
		}

		return bestIdx;
	}

	private int TryPickInventorySlotUsingScreenCoordsOnly( Vector2 screenPt )
	{
		if ( Panel is null )
			return -1;

		var bestIdx = -1;
		var bestCenterD2 = float.MaxValue;
		float bestArea = float.MaxValue;

		foreach ( var p in Panel.Descendants )
		{
			if ( p is null || !TryParseInventorySlotHitPanel( p, out var idx ) )
				continue;

			GetInvSlotPickRect( p, grow: 52f, out var r );

			var localPt = p.ScreenPositionToPanelPosition( screenPt );
			if ( !InvAxisRectContainsPoint( localPt, r ) )
				continue;

			var minX = MathF.Min( r.Left, r.Right );
			var maxX = MathF.Max( r.Left, r.Right );
			var minY = MathF.Min( r.Top, r.Bottom );
			var maxY = MathF.Max( r.Top, r.Bottom );
			var cx = (minX + maxX) * 0.5f;
			var cy = (minY + maxY) * 0.5f;
			var dxc = localPt.x - cx;
			var dyc = localPt.y - cy;
			var centerD2 = dxc * dxc + dyc * dyc;

			var a = Math.Max( 1f, r.Width ) * Math.Max( 1f, r.Height );

			if ( centerD2 < bestCenterD2
				|| (MathF.Abs( centerD2 - bestCenterD2 ) < 0.001f && a < bestArea) )
			{
				bestCenterD2 = centerD2;
				bestArea = a;
				bestIdx = idx;
			}
		}

		return bestIdx;
	}

	private int TryPickInvSlotNearestUsingPanelMouse( Vector2 screenPt, float maxPx )
	{
		if ( Panel is null )
			return -1;

		var bestInsideD2 = float.MaxValue;
		var bestInsideIdx = -1;
		var bestAnyD2 = float.MaxValue;
		var bestAnyIdx = -1;
		var max2 = maxPx * maxPx;

		foreach ( var p in Panel.Descendants )
		{
			if ( p is null || !TryParseInventorySlotHitPanel( p, out var idx ) )
				continue;

			GetInvSlotPickRect( p, grow: 52f, out var r );
			var mp = p.ScreenPositionToPanelPosition( screenPt );
			var minX = MathF.Min( r.Left, r.Right );
			var maxX = MathF.Max( r.Left, r.Right );
			var minY = MathF.Min( r.Top, r.Bottom );
			var maxY = MathF.Max( r.Top, r.Bottom );
			var cx = (minX + maxX) * 0.5f;
			var cy = (minY + maxY) * 0.5f;
			var dx = mp.x - cx;
			var dy = mp.y - cy;
			var d2 = dx * dx + dy * dy;

			if ( InvAxisRectContainsPoint( mp, r ) && d2 < bestInsideD2 )
			{
				bestInsideD2 = d2;
				bestInsideIdx = idx;
			}

			if ( d2 < bestAnyD2 )
			{
				bestAnyD2 = d2;
				bestAnyIdx = idx;
			}
		}

		if ( bestInsideIdx >= 0 )
			return bestInsideIdx;

		return bestAnyD2 <= max2 ? bestAnyIdx : -1;
	}

	/// <summary>Prefer full CSS cell <see cref="Sandbox.UI.Box.Rect"/> so hits match the visible 72×72 slot, not only the 55×55 inner icon.</summary>
	private static void GetInvSlotPickRect( Panel p, float grow, out Rect r )
	{
		r = p.Box.Rect;
		if ( r.Width <= 0.75f || r.Height <= 0.75f )
			r = p.Box.RectInner;

		r = r.Grow( grow );
	}

	/// <inheritdoc cref="SquaredDistancePointToAxisAlignedRect" />
	private static bool InvAxisRectContainsPoint( Vector2 pt, Rect r )
	{
		var minX = MathF.Min( r.Left, r.Right );
		var maxX = MathF.Max( r.Left, r.Right );
		var minY = MathF.Min( r.Top, r.Bottom );
		var maxY = MathF.Max( r.Top, r.Bottom );
		return pt.x >= minX && pt.x <= maxX && pt.y >= minY && pt.y <= maxY;
	}

	/// <summary>
	/// <see cref="Mouse.Position"/> is in game/window pixels; <see cref="Panel.FindInRect"/> uses the UI document space of
	/// <see cref="Panel.PanelPositionToScreenPosition"/> (often offset/scaled vs raw mouse — see dragPickDiag scrAABB).
	/// Round-trip through any slot maps game → slot-local → UI-space so probes match engine hit geometry.
	/// </summary>
	private Vector2 MouseGamePixelsToUiDocumentPickSpace( Vector2 gameMousePx )
	{
		if ( Panel is null )
			return gameMousePx;

		foreach ( var p in Panel.Descendants )
		{
			if ( p is null || !TryParseInventorySlotHitPanel( p, out _ ) )
				continue;

			var local = p.ScreenPositionToPanelPosition( gameMousePx );
			return p.PanelPositionToScreenPosition( local );
		}

		var rootLocal = Panel.ScreenPositionToPanelPosition( gameMousePx );
		return Panel.PanelPositionToScreenPosition( rootLocal );
	}

	private static float SquaredDistancePointToAxisAlignedRect( Vector2 localPt, Rect r )
	{
		var minX = MathF.Min( r.Left, r.Right );
		var maxX = MathF.Max( r.Left, r.Right );
		var minY = MathF.Min( r.Top, r.Bottom );
		var maxY = MathF.Max( r.Top, r.Bottom );

		var qx = localPt.x < minX ? minX : localPt.x > maxX ? maxX : localPt.x;
		var qy = localPt.y < minY ? minY : localPt.y > maxY ? maxY : localPt.y;

		var dx = localPt.x - qx;
		var dy = localPt.y - qy;

		return dx * dx + dy * dy;
	}

	/// <summary>
	/// Most reliable picker: <see cref="Mouse.Position"/> projected into each slot's layout rect vs <see cref="Sandbox.UI.Box.Rect"/>.
	/// Does not use <see cref="Panel.FindInRect"/> (mismatched vs game-mouse space in diagnostics).
	/// </summary>
	private int PickInventorySlotByClosestLocalRect( Vector2 gameMousePx )
	{
		if ( Panel is null || Inventory is null )
			return -1;

		const float maxPickDistPx = 1200f;
		var maxD2 = maxPickDistPx * maxPickDistPx;

		var bestD2 = float.MaxValue;
		var bestIdx = -1;

		foreach ( var p in Panel.Descendants )
		{
			if ( p is null || !TryParseInventorySlotHitPanel( p, out var idx ) )
				continue;

			if ( idx < 0 || idx >= Inventory.TotalSlotCount )
				continue;

			var outer = p.Box.Rect;
			if ( outer.Width <= 0.75f || outer.Height <= 0.75f )
				outer = p.Box.RectInner;

			var localPt = p.ScreenPositionToPanelPosition( gameMousePx );
			// Tight bounds (no big Grow): multiple panels with d2≈0 was picking the first in Descendants (always slot 8 or 0).
			var d2 = SquaredDistancePointToAxisAlignedRect( localPt, outer );
			if ( d2 < bestD2 )
			{
				bestD2 = d2;
				bestIdx = idx;
			}
		}

		if ( bestIdx < 0 )
			return -1;

		if ( bestD2 > maxD2 )
			return -1;

		HudDbg( $"drag pick closest-local d≤{MathF.Sqrt( bestD2 ):0.#} px (cap {maxPickDistPx}) idx={bestIdx}" );
		return bestIdx;
	}

	/// <summary>Slot-backed panel: parses <c>sidx-</c> / id prefixes, prefers <see cref="Panel.HasClass"/> <c>inv-slot</c>.</summary>
	private static bool TryParseInventorySlotHitPanel( Panel p, out int idx )
	{
		idx = -1;
		return p.HasClass( "inv-slot" ) && TryParseSlotIndexFromInvSlotPanel( p, out idx );
	}

	private static string CssClassTokens( Panel p )
	{
		if ( p is null )
			return "";
		if ( !string.IsNullOrWhiteSpace( p.Classes ) )
			return p.Classes;

		if ( p.Class == null )
			return "";

		var parts = new List<string>();
		foreach ( var o in p.Class )
		{
			if ( o is not string c || string.IsNullOrWhiteSpace( c ) )
				continue;
			parts.Add( c );
		}

		return parts.Count == 0 ? "" : string.Join( ' ', parts );
	}

	private static bool TryParseInventorySlotTokenFromClasses( string classes, out int slot )
	{
		slot = -1;
		if ( string.IsNullOrEmpty( classes ) )
			return false;

		const string token = "sidx-";

		foreach ( var part in classes.Split( ' ', StringSplitOptions.RemoveEmptyEntries ) )
		{
			if ( !part.StartsWith( token, StringComparison.Ordinal ) )
				continue;

			var tail = part.Substring( token.Length );
			if ( int.TryParse( tail, out var idx ) )
			{
				slot = idx;
				return true;
			}
		}

		return false;
	}

	private static bool TryParseSlotIndexFromInvSlotPanel( Panel p, out int idx )
	{
		idx = -1;
		if ( p is null )
			return false;

		if ( TryParseInventorySlotTokenFromClasses( CssClassTokens( p ), out idx ) )
			return true;

		var id = p.Id;
		const string win = "inv-slot-win-";
		const string dock = "inv-slot-dock-";
		if ( !string.IsNullOrEmpty( id ) )
		{
			if ( id.StartsWith( win, StringComparison.Ordinal ) && int.TryParse( id.Substring( win.Length ), out idx ) )
				return true;

			if ( id.StartsWith( dock, StringComparison.Ordinal ) && int.TryParse( id.Substring( dock.Length ), out idx ) )
				return true;
		}

		return false;
	}

	/// <summary>
	/// Map layout rect to clip-space using <see cref="Panel.PanelPositionToScreenPosition"/> (Box alone is layout/parent-relative).
	/// </summary>
	private static bool TryGetInvSlotHitRectInScreenSpace( Panel slotPanel, out Rect screenBounds )
	{
		screenBounds = default;
		if ( slotPanel is null )
			return false;

		var sz = GetSlotLocalSize( slotPanel );
		if ( sz.x <= 0.75f || sz.y <= 0.75f )
			return false;

		const float grow = 8f;
		var topLeftLocal = new Vector2( -grow, -grow );
		var bottomRightLocal = new Vector2( sz.x + grow, sz.y + grow );
		var topLeftScreen = slotPanel.PanelPositionToScreenPosition( topLeftLocal );
		var bottomRightScreen = slotPanel.PanelPositionToScreenPosition( bottomRightLocal );
		screenBounds = Rect.FromPoints( topLeftScreen, bottomRightScreen );
		return screenBounds.Width > 2f && screenBounds.Height > 2f;
	}

	private int TryPickSlotUsingPanelLocalCoords( Vector2 gameMousePx )
	{
		if ( Panel is null || Inventory is null )
			return -1;

		// Slop must clear pointer→local projection used by the engine (see dragPickDiag loc52); 10px left every cell as "outside".
		// Overlaps are resolved by nearest rect center, not by Descendants order.
		const float pickSlop = 52f;

		var bestIdx = -1;
		var bestCenterD2 = float.MaxValue;
		var bestArea = float.MaxValue;

		foreach ( var p in Panel.Descendants )
		{
			if ( p is null || !TryParseInventorySlotHitPanel( p, out var idx ) )
				continue;

			if ( idx < 0 || idx >= Inventory.TotalSlotCount )
				continue;

			GetInvSlotPickRect( p, grow: pickSlop, out var r );
			var localPtr = p.ScreenPositionToPanelPosition( gameMousePx );
			if ( !InvAxisRectContainsPoint( localPtr, r ) )
				continue;

			var minX = MathF.Min( r.Left, r.Right );
			var maxX = MathF.Max( r.Left, r.Right );
			var minY = MathF.Min( r.Top, r.Bottom );
			var maxY = MathF.Max( r.Top, r.Bottom );
			var cx = (minX + maxX) * 0.5f;
			var cy = (minY + maxY) * 0.5f;
			var dxc = localPtr.x - cx;
			var dyc = localPtr.y - cy;
			var centerD2 = dxc * dxc + dyc * dyc;

			var a = Math.Max( 1f, r.Width ) * Math.Max( 1f, r.Height );

			if ( centerD2 < bestCenterD2
				|| (MathF.Abs( centerD2 - bestCenterD2 ) < 0.001f && a < bestArea) )
			{
				bestCenterD2 = centerD2;
				bestArea = a;
				bestIdx = idx;
			}
		}

		return bestIdx;
	}

	private int TryResolveSlotIndexFromTopmostHit( Vector2 gameMousePx )
	{
		if ( Panel is null )
			return -1;

		var uiPick = MouseGamePixelsToUiDocumentPickSpace( gameMousePx );
		var probe = Rect.FromPoints( uiPick + new Vector2( -40f ), uiPick + new Vector2( 40f ) );
		var hit = TryResolveSlotIndexFromFindInRectProbe( probe, visibleLeavesOnly: true );
		if ( hit >= 0 )
			return hit;

		return TryResolveSlotIndexFromFindInRectProbe( probe, visibleLeavesOnly: false );
	}

	private static int CountPanelAncestors( Panel p )
	{
		var n = 0;
		for ( ; p is not null; p = p.Parent )
			n++;

		return n;
	}

	/// <summary>Prefer slot rect containing point, nearest-center wins ties.</summary>
	/// <param name="uiDocumentPx">Same space as <see cref="Panel.PanelPositionToScreenPosition"/> (not raw <see cref="Mouse.Position"/>).</param>
	private static int PickBestMatchingSlotUnderPoint( IEnumerable<Panel> candidates, Vector2 uiDocumentPx )
	{
		var bestIdx = -1;
		float bestArea = float.MaxValue;
		var bestCenterD2 = float.MaxValue;

		foreach ( var p in candidates )
		{
			if ( p is null || !TryParseInventorySlotHitPanel( p, out var idx ) )
				continue;

			if ( !TryGetInvSlotHitRectInScreenSpace( p, out var sb ) || !InvAxisRectContainsPoint( uiDocumentPx, sb ) )
				continue;

			var a = Math.Max( 1f, sb.Width ) * Math.Max( 1f, sb.Height );
			var minX = MathF.Min( sb.Left, sb.Right );
			var maxX = MathF.Max( sb.Left, sb.Right );
			var minY = MathF.Min( sb.Top, sb.Bottom );
			var maxY = MathF.Max( sb.Top, sb.Bottom );
			var cx = (minX + maxX) * 0.5f;
			var cy = (minY + maxY) * 0.5f;
			var dx = uiDocumentPx.x - cx;
			var dy = uiDocumentPx.y - cy;
			var centerD2 = dx * dx + dy * dy;

			if ( centerD2 < bestCenterD2 || (MathF.Abs( centerD2 - bestCenterD2 ) < 0.001f && a < bestArea) )
			{
				bestCenterD2 = centerD2;
				bestArea = a;
				bestIdx = idx;
			}
		}

		return bestIdx;
	}

	/// <summary>Resolve which inventory/hotbar cell is under the cursor for drag-drop.</summary>
	/// <param name="gameMousePx"><see cref="Mouse.Position"/> / framebuffer-style pixels.</param>
	private int TryGetSlotIndexUnderScreenPoint( Vector2 gameMousePx )
	{
		if ( Panel is null )
			return -1;

		var uiPick = MouseGamePixelsToUiDocumentPickSpace( gameMousePx );
		return PickBestMatchingSlotUnderPoint( Panel.Descendants, uiPick );
	}

	private void UpdateDragMouse()
	{
		var m = Mouse.Position;
		if ( Panel is null )
		{
			_dragMouseX = m.x;
			_dragMouseY = m.y;
			return;
		}

		// ScreenPanel / editor scale: Mouse is in screen pixels; left/top on this panel are in layout space.
		var origin = Panel.PanelPositionToScreenPosition( Vector2.Zero );
		var delta = m - origin;
		var s = Panel.ScaleToScreen;
		if ( s < 0.0001f )
			s = 1f;

		_dragMouseX = delta.x / s;
		_dragMouseY = delta.y / s;
	}

	private bool TryGetDragPreview( out InventoryItemDefinitionEntry def, out int count )
	{
		def = null;
		count = 0;
		if ( Inventory is null || _dragFrom < 0 || !_dragUiCapture )
			return false;

		var slot = Inventory.GetSlot( _dragFrom );
		if ( slot.IsEmpty )
			return false;

		if ( !Inventory.TryGetDefinition( slot.ItemId, out def ) )
			return false;

		count = slot.Count;
		return true;
	}

	private static Panel FindDescendantWithClass( Panel root, string className )
	{
		if ( root is null )
			return null;

		foreach ( var d in root.Descendants )
		{
			if ( d is null || !d.IsValid || string.IsNullOrEmpty( className ) )
				continue;

			if ( d.HasClass( className ) )
				return d;
		}

		return null;
	}

	/// <summary>
	/// Drive ghost position on the live <see cref="Panel"/> every update so movement is sub-pixel smooth.
	/// Razor rebuilds were gated on <c>(int)</c> mouse coords and only ran on game tick — looked stepped/skippy.
	/// </summary>
	private void ApplyDragGhostPanelPosition()
	{
		if ( _dragGhostPanel is null || !_dragGhostPanel.IsValid )
			_dragGhostPanel = FindDescendantWithClass( Panel, "inv-drag-ghost" );

		if ( _dragGhostPanel is null )
			return;

		_dragGhostPanel.Style.Position = PositionMode.Absolute;
		_dragGhostPanel.Style.Left = Length.Pixels( _dragMouseX );
		_dragGhostPanel.Style.Top = Length.Pixels( _dragMouseY );
	}

	protected override void OnTreeBuilt()
	{
		base.OnTreeBuilt();

		if ( _dragPump is not null )
			_dragPump.Host = this;

		if ( !_dragUiCapture || _dragFrom < 0 )
			return;

		RebuildSlotPanelCache();
		ApplyRootPointerPassthroughUnlessDragging();
		_dragGhostScreenPx = Mouse.Position;
		UpdateDragGhostFromRootMouse();
		var hover = ResolveHoveredSlotScreenSpaceCached( _dragGhostScreenPx );
		_hoverSlot = hover;
		if ( hover >= 0 )
			_dragLastHoverSlot = hover;
		ApplyDragDecorations( sourceIdx: _dragFrom, hoverIdx: hover );
	}

	protected override void OnUpdate()
	{
		base.OnUpdate();

		ApplyRootPointerPassthroughUnlessDragging();
		SyncGameplayMouseForPlayerController();

		if ( Inventory is not null && _dragUiCapture && _dragFrom >= 0 && Panel is not null && Panel.IsValid )
		{
			UpdateDragGhostFromRootMouse();
			UpdateDragHoverFromScreenPointAndApply();
			if ( Inventory.DebugInventory )
				_dragDbgGhostCalls++;
			TryHudDragTelemetrySecondTick();
		}

		if ( Inventory is null )
			return;

		if ( !Inventory.IsInventoryOpen )
		{
			if ( _dragUiCapture )
			{
				if ( GameMovementInput.InputReleasedFlexible( "Attack1" ) )
				{
					HudDbg( $"closed hotbar drag release from={_dragFrom}" );
					FinishPointerDrag( HudReason: "closed-release-attack1", boundSlot: _dragFrom );
					StateHasChanged();
				}
			}
			else
			{
				if ( GameMovementInput.InputPressedFlexible( "Attack1" ) )
				{
					var pick = ResolveSlotByUiDocumentPoint( Mouse.Position );
					var hotEnd = Inventory.HotbarSlotCount;
					if ( pick >= 0 && pick < hotEnd && !Inventory.GetSlot( pick ).IsEmpty )
					{
						BeginSlotDragFromFilledSlot( pick, "dock" );
						HudDbg( $"closed hotbar drag start slot={pick}" );
						StateHasChanged();
					}
				}
				else if ( GameMovementInput.InputPressedFlexible( "Attack2" ) )
				{
					var pick = ResolveSlotByUiDocumentPoint( Mouse.Position );
					if ( pick >= 0 && pick < Inventory.HotbarSlotCount )
					{
						TrySplitToFirstEmpty( pick );
						StateHasChanged();
					}
				}
			}
		}

		if ( !Inventory.IsInventoryOpen || _scenePreviewBuilt )
			return;

		TryInitScenePreview();
	}

	private void TryInitScenePreview()
	{
		if ( _scenePanel is null )
			return;

		// ScenePanel preview: avoid obsolete ScenePanel.Camera; wire scene/camera via editor when migrating to the new Scene API.
		_scenePreviewBuilt = true;
	}

	protected override int BuildHash()
	{
		var showGhost = _dragFrom >= 0 && _dragUiCapture;
		return System.HashCode.Combine(
			GameBuildLabel.Display,
			Inventory?.SlotBlob,
			Inventory?.IsInventoryOpen,
			Inventory?.HotbarSelectedIndex,
			_dragFrom,
			_dragUiCapture,
			showGhost ? 1 : 0 );
	}
}
