@namespace Game
@using System.Collections.Generic
@using Sandbox
@using Sandbox.UI
@inherits Panel

<root class="@RootClass()" />

@code
{
	[Property] public string TexturePath { get; set; } = "";

	[Property] public string ExtraClass { get; set; } = "";

	private string _lastApplied = "\0";

	private string RootClass()
	{
		var extra = ExtraClass?.Trim() ?? "";
		var hasRaw = extra.Contains( "inv-icon-raw", StringComparison.Ordinal );
		var pad = hasRaw ? "" : "inv-slot-fill";
		if ( string.IsNullOrEmpty( pad ) )
			return string.IsNullOrEmpty( extra ) ? "inv-icon-raw" : extra;
		return string.IsNullOrEmpty( extra ) ? pad : $"{pad} {extra}";
	}

	public override void Tick()
	{
		base.Tick();

		if ( string.Equals( _lastApplied, TexturePath ?? "", StringComparison.Ordinal ) )
			return;

		_lastApplied = TexturePath ?? "";
		ApplyTexture();
	}

	private void ApplyTexture()
	{
		if ( string.IsNullOrWhiteSpace( TexturePath ) )
		{
			Style.BackgroundImage = null;
			return;
		}

		var raw = TexturePath.Trim().Replace( "\\", "/" ).TrimStart( '/' );
		Texture tex = null;
		foreach ( var candidate in EnumerateIconPathCandidates( raw ) )
		{
			try
			{
				if ( FileSystem.Mounted is not null && FileSystem.Mounted.FileExists( candidate ) )
				{
					tex = Texture.LoadFromFileSystem( candidate, FileSystem.Mounted );
					if ( tex is not null )
						break;
				}
			}
			catch
			{
				// try next
			}
		}

		if ( tex is null )
		{
			foreach ( var candidate in EnumerateIconPathCandidates( raw ) )
			{
				try
				{
					tex = Texture.Load( candidate );
					if ( tex is not null )
						break;
				}
				catch
				{
					// try next
				}
			}
		}

		if ( tex is null )
		{
			Log.Warning( $"[InvSlotIconFill] could not load icon for '{raw}' (tried mounted paths + Texture.Load)" );
			Style.BackgroundImage = null;
			return;
		}

		Style.SetBackgroundImage( tex );
	}

	private static IEnumerable<string> EnumerateIconPathCandidates( string p )
	{
		if ( string.IsNullOrWhiteSpace( p ) )
			yield break;

		yield return p;

		var lower = p.ToLowerInvariant();
		if ( !string.Equals( p, lower, StringComparison.Ordinal ) )
			yield return lower;

		var slash = p.LastIndexOf( '/' );
		var file = slash >= 0 && slash + 1 < p.Length ? p[(slash + 1)..] : p;
		var fileLower = file.ToLowerInvariant();

		yield return $"assets/itempngs/{fileLower}";
		yield return $"Assets/itemPngs/{file}";
		yield return $"itempngs/{fileLower}";
		yield return $"itemPngs/{file}";
	}

	protected override int BuildHash() => System.HashCode.Combine( TexturePath, ExtraClass );
}
