        { "pieceId": "build_wood_floor", "x": -2, "y": -2 },
        { "pieceId": "build_wood_floor", "x": 0, "y": -2 },
        { "pieceId": "build_wood_floor", "x": 2, "y": -2 },
        { "pieceId": "build_wood_floor", "x": -2, "y": 0 },
        { "pieceId": "build_wood_floor", "x": 0, "y": 0 },
        { "pieceId": "build_wood_floor", "x": 2, "y": 0 },
        { "pieceId": "build_wood_floor", "x": -2, "y": 2 },
        { "pieceId": "build_wood_floor", "x": 0, "y": 2 },
        { "pieceId": "build_wood_floor", "x": 2, "y": 2 }
      ],
      "entities": [
        { "archetype": "Scav", "tier": 1, "x": -4, "y": -4, "yawDegrees": 45 },
        { "archetype": "Scav", "tier": 1, "x": 4, "y": -4, "yawDegrees": 135 },
        { "archetype": "Scav", "tier": 1, "x": 4, "y": 4, "yawDegrees": -135 },
