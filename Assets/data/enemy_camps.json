{
  // Enemy camp layouts. Offsets are camp-local meters in the build kit's space (50 u/m, same as
  // build pieces) so entity positions line up with piece footprints: a 2 m floor is one tile.
  // X = camp forward, Y = camp left, Z = up from the ground at the camp origin. yawDegrees is
  // relative to the camp's facing. wanderDistanceMeters / maxTravelDistanceMeters are two rings
  // centered on the camp origin: guards wander within the first; pulled past the second they drop
  // their target and run back. Camp values are defaults; an entity row can override the distances.
  "camps": [
    {
      "id": "scav_outpost_test",
      "displayName": "Scav Outpost (test)",
      "wanderDistanceMeters": 24,
      "maxTravelDistanceMeters": 80,
