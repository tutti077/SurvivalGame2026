{
  // Points of interest (Code/Pois, Mark 2026-11-19). Two kinds:
  //   structures  discoverable: generated with the world, found by walking into them. Each row is a grid of world cells
  //               spacingMeters wide; a cell rolls chance, then needs open, flat, dry ground in its biome (the scav camps'
  //               site rules) and builds one of its layouts, picked by hash. seedSalt keeps two rows off the same cells.
  //   landmarks   distant + visible: a prefab scattered with the large trees (it exists out to Tree Objects Range, so the
  //               smoke over it shows from far off). chancePerChunk = chance one 64 m chunk of the biome holds it;
  //               clearingRadiusMeters keeps it out of the trees; bareGroundRadiusMeters = no grass clumps within this radius (the terrain itself is not painted: the prefab brings its own ground).
  "structures": [
    {
      // Abandoned, seemingly player-built shelters: a chest, an unlit campfire, a roasting spit, a bed nobody owns.
      "id": "abandoned_structure",
      "displayName": "Abandoned Structure",
      "biome": "CloverHills",
      "spacingMeters": 450,
      "chance": 0.85,
      "seedSalt": 900,
      "layouts": [ "abandoned_shack", "abandoned_cabin", "abandoned_leanto" ]
    }
  ],
  "landmarks": [
    {
      // Crashed stasis pod under a smoke column (prefabs/props/crashed_pod_v1.prefab: MineableRock -> scrap, SmokeColumn).
      "id": "crashed_pod",
      "displayName": "Crashed Stasis Pod",
      "biome": "CloverHills",
      "prefab": "prefabs/props/crashed_pod_v1.prefab",
      "chancePerChunk": 0.02,
      "seedSalt": 0,
      "clearingRadiusMeters": 7,
      "bareGroundRadiusMeters": 3.85
    }
  ],
  // Layouts: build pieces as offsets from the structure's origin, in metres at the build kit's scale (a 2 m floor is one
  // tile). X = forward, Y = left, z = height of the piece's underside above the ground at the origin. Pieces are listed
  // bottom-up (floors, walls, roof, furniture) so each stands on what is already there. "loot" on a container piece
  // names a table below. Piece frames at yawDegrees 0: a wall stands across X (it runs along Y); a 45 roof is low on -X.
  "layouts": [
    {
      "id": "abandoned_shack",
      "displayName": "Abandoned Shack",
