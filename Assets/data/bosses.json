      "archetype": "Scav",
      "tier": 1,
      "health": 300,
      "healthBarRangeMeters": 500,
      "abandonDespawnSeconds": 60,
      "hasSecondForm": true,
      "secondFormHealth": 300,
      "secondFormBarColor": "#2ecc40"
    }
  ]
}
